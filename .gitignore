# ---------------------------------------------------------------------------
# Build and verification artefacts
# ---------------------------------------------------------------------------
# Headless Chrome writes a ~10 MB profile per run; the tools delete it, but it
# exists briefly and must never be committed.
.verify/
chrome-profile/

# Node (the build needs no packages, but keep this in case someone adds them)
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Vercel / deployment
# ---------------------------------------------------------------------------
.vercel/
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors and OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Note: omarchy.html and index.html at the root ARE generated by
# tools/build.mjs, but they are committed on purpose. They are the deliverable —
# the whole point is that a visitor can clone and double-click with no build
# step, and Vercel can deploy with no build step. Do not add them here.
# ---------------------------------------------------------------------------
